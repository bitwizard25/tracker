SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=./data/tracker.db

# Number of trusted reverse proxies that APPEND to x-forwarded-for (default 1).
# The client IP used for rate limiting is read from the right of that header, so it is
# only trustworthy behind exactly this many appending proxies. The per-email limiter is
# the real brute-force defence; the IP limiter is a secondary guard.
# TRUSTED_PROXY_HOPS=1

# Demo accounts (demo1..demo8@example.com / password123) are seeded automatically by `npm run dev`,
# `build` and `start` when missing. They are skipped when NODE_ENV=production.
# Set SEED_DEMO_DATA=true to force seeding or SEED_DEMO_DATA=false to disable it.
# SEED_DEMO_DATA=false

# Vercel / serverless demo mode: when VERCEL is set the database is a temp-storage SQLite file that is
# migrated and seeded with demo users on first use. Data is wiped on cold starts and is NOT shared
# between instances, so it is for demos only. Set SESSION_SECRET in the Vercel project settings.
