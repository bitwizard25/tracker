SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=./data/tracker.db

# Number of trusted reverse proxies that APPEND to x-forwarded-for (default 1).
# The client IP used for rate limiting is read from the right of that header, so it is
# only trustworthy behind exactly this many appending proxies. The per-email limiter is
# the real brute-force defence; the IP limiter is a secondary guard.
# TRUSTED_PROXY_HOPS=1
